# Add these in Vercel → Project → Settings → Environment Variables
# Scope: Production, Preview, and Development.
# Do NOT prefix GEMINI or PYTH with NEXT_PUBLIC — they stay server-side.

# Required for the AI parser (Google AI Studio).
GEMINI_API_KEY=

# Get this from Pyth Terminal (free trial). Used by /api/prices.
PYTH_API_KEY=

# Optional. Public mainnet works; a Helius/Triton RPC is more reliable on demo day.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Defaults to mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
