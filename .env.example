# Add these in Vercel → Project → Settings → Environment Variables
# Scope: Production, Preview, and Development.
# Do NOT prefix GEMINI or PYTH with NEXT_PUBLIC — they stay server-side.

# Optional. Local parser handles the demo prompt without this.
# Add later from Google AI Studio if you want free-form English.
GEMINI_API_KEY=

# Required for live Pyth Pro prices (the Bearer token from Pyth Terminal).
# Paste ONLY the token, not the whole curl. Example value looks like a long base58 string.
PYTH_API_KEY=

# Optional. Public mainnet works; a Helius/Triton RPC is more reliable on demo day.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Defaults to mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
