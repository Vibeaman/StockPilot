# Server-side only. Never expose in client code.
GEMINI_API_KEY=

# Optional. Hermes requires a key after the Aug 2026 Pyth Core upgrade.
# Get a free trial key from Pyth Terminal.
PYTH_API_KEY=

# Optional. Public mainnet RPC works for the demo; a private RPC is more reliable.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Defaults to mainnet.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
